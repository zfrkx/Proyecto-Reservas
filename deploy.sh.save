#!/bin/bash
set -e

GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${BLUE}====================================================${NC}"
echo -e "${BLUE} 🚀 DESPLEGANDO PLATAFORMA DISTRIBUIDA DE RESERVAS ${NC}"
echo -e "${BLUE}====================================================${NC}"

# 1. OpenTofu - Infraestructura como Código
echo -e "\n${GREEN}[1/3] Aprovisionando Infraestructura con OpenTofu...${NC}"
if [ -d "tofu" ]; then
    cd tofu
    tofu init
    tofu apply -auto-approve
    cd ..
else
    echo -e "${RED}⚠️ No se encontró la carpeta tofu. Saltando IaC...${NC}"
fi

# 2. Ansible - Configuración de Nodos
echo -e "\n${GREEN}[2/3] Configurando Servicios con Ansible...${NC}"
cd ansible
ansible-playbook -i inventory.ini site.yml
cd ..

# 3. Smoke Test - Prueba de Humo
echo -e "\n${GREEN}[3/3] Ejecutando Prueba de Humo (Smoke Test)...${NC}"
sleep 3
RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" http://10.10.0.97/recursos || true)

if [ "$RESPONSE" -eq 200 ] || [ "$RESPONSE" -eq 201 ]; then
    echo -e "${GREEN}✅ ¡Despliegue Exitoso! El API Gateway (10.10.0.97) responde correctamente.${NC}"
else
    echo -e "${RED}❌ Alerta: La prueba de humo falló con código HTTP $RESPONSE.${NC}"
fi

echo -e "\n${BLUE}====================================================${NC}"
echo -e "${BLUE} 📊 Grafana: http://localhost:3000${NC}"
echo -e "${BLUE} 🌐 API Gateway: http://10.10.0.97/recursos${NC}"
echo -e "${BLUE}====================================================${NC}"
